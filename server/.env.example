NODE_ENV=development
PORT=5000
HOST=0.0.0.0
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>/<database>?retryWrites=true&w=majority
JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d
# For direct browser requests, list permitted origins separated by commas.
# The Vite development proxy does not need this setting.
CORS_ORIGIN=http://localhost:5173
# Keep false in real deployments. Set true only for a local demo where users
# may choose Farmer, Procurement Staff, or Admin while registering.
ALLOW_SELF_REGISTERED_ROLES=false
# Set all three values to enable Firebase Admin push delivery. Keep private_key quoted with escaped newlines.
FIREBASE_PROJECT_ID=your-firebase-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n"
# Public Firebase Web configuration (safe to expose; use it for the service worker)
FIREBASE_WEB_API_KEY=
FIREBASE_WEB_AUTH_DOMAIN=
FIREBASE_WEB_STORAGE_BUCKET=
FIREBASE_WEB_MESSAGING_SENDER_ID=
FIREBASE_WEB_APP_ID=
